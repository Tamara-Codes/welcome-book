{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/((?!robots.txt|sitemap.xml).+)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "crons": [{ "path": "/api/cron/daily-analytics", "schedule": "0 9 * * *" }]
}
