# Copy this file to ".env" and fill in what you need.
# These are read at build time by Vite (must start with VITE_).

# ── Landing page: where inquiry-form submissions go ─────────────────────────
# OPTION 1 (recommended): a POST endpoint that receives the inquiry as JSON
# (Formspree / Formspark / Basin / a Google Apps Script, …). If set, the form
# posts there and shows the success message in-page.
VITE_INQUIRY_FORM_ENDPOINT=

# OPTION 2 (fallback): if no endpoint is set above, submitting opens the
# visitor's email app with a pre-filled message to this address.
VITE_INQUIRY_EMAIL=tamara@algorise.co.uk

# ── Landing page: which guide the "Otvori živi demo" button opens ───────────
# Defaults to the bundled demo property at /danica. Override only if you want
# the button to point somewhere else (e.g. a different slug or full URL).
VITE_DEMO_URL=
